<Window x:Class="VisionInspection.UI.Views.SopDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOP 检测数据看板"
        Height="760" Width="1440"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 筛选工具栏 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="操作员：" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbOperator" Width="120" Margin="0,0,14,0" FontSize="13"/>
                <TextBlock Text="产品配方：" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <ComboBox x:Name="cmbWorkflow" Width="180" Margin="0,0,14,0" FontSize="13"/>
                <TextBlock Text="开始：" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <DatePicker x:Name="dpStart" Width="120" Margin="0,0,14,0" FontSize="13"/>
                <TextBlock Text="结束：" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                <DatePicker x:Name="dpEnd" Width="120" Margin="0,0,14,0" FontSize="13"/>
                <Button x:Name="btnQuery" Content="查询" Width="80" Height="30" Click="BtnQuery_Click"
                        Background="#2C8C8C" Foreground="White" BorderThickness="0" FontSize="13"/>
                <Button x:Name="btnRefresh" Content="刷新数据" Width="90" Height="30" Margin="10,0,0,0" Click="BtnQuery_Click"
                        Background="#E2E8F0" Foreground="#374151" BorderThickness="0" FontSize="13"/>
                <Button x:Name="btnCheck" Content="检查完整性" Width="90" Height="30" Margin="10,0,0,0" Click="BtnCheck_Click"
                        Background="#E2E8F0" Foreground="#374151" BorderThickness="0" FontSize="13"/>
                <Button x:Name="btnExport" Content="导出 CSV" Width="90" Height="30" Margin="10,0,0,0" Click="BtnExport_Click"
                        Background="#2C8C8C" Foreground="White" BorderThickness="0" FontSize="13"/>
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" MaxWidth="220"/>
            </StackPanel>
        </Border>

        <!-- KPI 卡片 -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="130">
                <StackPanel>
                    <TextBlock Text="总周期" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#374151"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="130">
                <StackPanel>
                    <TextBlock Text="OK" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtOk" Text="0" FontSize="26" FontWeight="Bold" Foreground="#4FA86A"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="130">
                <StackPanel>
                    <TextBlock Text="NG" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtNg" Text="0" FontSize="26" FontWeight="Bold" Foreground="#E05353"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="130">
                <StackPanel>
                    <TextBlock Text="合格率" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtOkRate" Text="0%" FontSize="26" FontWeight="Bold" Foreground="#2C8C8C"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="150">
                <StackPanel>
                    <TextBlock Text="平均实际耗时" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtAvgTotal" Text="0.0s" FontSize="26" FontWeight="Bold" Foreground="#374151"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="150">
                <StackPanel>
                    <TextBlock Text="平均标准耗时" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtAvgStd" Text="—" FontSize="26" FontWeight="Bold" Foreground="#9AA5B1"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="16,10" Margin="0,0,10,0" Width="150">
                <StackPanel>
                    <TextBlock Text="平均偏差" FontSize="12" Foreground="#6B7280"/>
                    <TextBlock x:Name="txtDeviation" Text="—" FontSize="26" FontWeight="Bold" Foreground="#E8915B"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- 主体：左=周期明细（主展示区），右=小区域图表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="720"/>
            </Grid.ColumnDefinitions>

            <!-- 周期明细（主展示区） -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="周期明细" FontSize="15" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <DataGrid x:Name="dgCycles" AutoGenerateColumns="False" HeadersVisibility="Column"
                              FontSize="12" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/>
                            <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="80"/>
                            <DataGridTextColumn Header="配方" Binding="{Binding WorkflowName}" Width="*"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="50"/>
                            <DataGridTextColumn Header="实际(s)" Binding="{Binding TotalDurationSec}" Width="64"/>
                            <DataGridTextColumn Header="标准(s)" Binding="{Binding StandardTotalSec}" Width="64"/>
                            <DataGridTextColumn Header="偏差(s)" Binding="{Binding DeviationSec}" Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 小区域：违规排行 + 标准VS实际 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 违规步骤排行 -->
                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="违规步骤排行（按出现次数）" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="icViolations">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
                                            <Grid Grid.Column="1">
                                                <Border Background="#E2E8F0" Height="18" CornerRadius="3"/>
                                                <Border Background="#E05353" Width="{Binding BarWidthPx}" Height="18" CornerRadius="3" HorizontalAlignment="Left"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#E05353"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoViolation" Text="该筛选条件下无违规记录" FontSize="11" Foreground="#9AA5B1" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 标准 vs 实际 每步耗时 -->
                    <Border Background="White" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="各步骤 标准 vs 实际 平均耗时" FontSize="14" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="icStepCompare">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StepName}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                                            <StackPanel Grid.Column="1" Width="340" Margin="0,0,10,0">
                                                <TextBlock Text="标准" FontSize="12" Foreground="#6B7280"/>
                                                <Border Background="#E2E8F0" Height="18" CornerRadius="3">
                                                    <Border Background="#9AA5B1" Height="18" Width="{Binding StdBarPx}" CornerRadius="3" HorizontalAlignment="Left"/>
                                                </Border>
                                                <TextBlock Text="实际" FontSize="12" Foreground="#6B7280" Margin="0,5,0,0"/>
                                                <Border Background="#E2E8F0" Height="18" CornerRadius="3">
                                                    <Border Background="#E8915B" Height="18" Width="{Binding ActualBarPx}" CornerRadius="3" HorizontalAlignment="Left"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StandardText}" FontSize="13" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding ActualText}" FontSize="13" Foreground="#374151" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DeviationText}" FontSize="13" Foreground="{Binding DeviationColor}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="txtNoStep" Text="无步骤耗时数据" FontSize="11" Foreground="#9AA5B1" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
