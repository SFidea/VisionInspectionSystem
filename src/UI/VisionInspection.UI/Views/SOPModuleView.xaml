<UserControl x:Class="VisionInspection.UI.Views.SOPModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisionInspection.UI.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400"
             Loaded="SOPModuleView_Loaded">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 整窗顶部标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="SOP检测模块" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 顶部操作工具栏 + 配方栏 -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="1,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部操作工具栏：标定 / 配置 / 运行 / 复位 / 日志
                     用 WrapPanel：右侧面板较窄时按钮自动换行，不会互相挤压或裁切 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,5,5">
                    <Button x:Name="RegionButton" Content="🎯 标定" Margin="4,0" Padding="8,0"
                            ToolTip="标定 SOP 检测区域"
                            Click="RegionButton_Click" Height="30"/>
                    <Button x:Name="ConfigButton" Content="⚙️ 配置" Margin="4,0" Padding="8,5"
                            ToolTip="编辑当前配方步骤与检测参数"
                            Click="ConfigButton_Click" Height="30"/>
                    <Button x:Name="RunButton" Content="▶️ 运行" Margin="4,0" Padding="8,5"
                            Background="#52C41A" Foreground="White"
                            ToolTip="启动 / 停止 SOP 实时检测"
                            Click="RunButton_Click" Height="30"/>
                    <!-- ⭐ 复位：紧邻「运行」右侧，用于清除当前周期结果、把流程复位到第一步 -->
                    <Button x:Name="ResetButton" Content="🔄 复位" Margin="4,0" Padding="8,5"
                            Background="#FA8C16" Foreground="White"
                            ToolTip="停止检测并将 SOP 流程复位到第一步（清空步骤状态与耗时）"
                            Click="ResetButton_Click" Height="30"/>
                    <!-- ⭐ 运行日志已移至独立窗口 -->
                    <Button x:Name="LogButton" Content="📝 日志" Margin="4,0" Padding="8,5"
                            ToolTip="打开独立运行日志窗口"
                            Click="LogButton_Click" Height="30"/>
                </WrapPanel>

                <!-- 配方栏 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                x:Name="RecipePanel">
                        <StackPanel.ContextMenu>
                            <ContextMenu x:Name="RecipeActionsContextMenu">
                                <MenuItem Header="➕ 新建" Click="NewRecipeButton_Click"
                                          ToolTip="基于模板或空白新建一个产品配方"/>
                                <MenuItem x:Name="RenameRecipeMenuItem" Header="✏️ 重命名" Click="RenameRecipeButton_Click"
                                          ToolTip="修改当前配方的产品名称" IsEnabled="False"/>
                                <MenuItem x:Name="DeleteRecipeMenuItem" Header="🗑 删除" Click="DeleteRecipeButton_Click"
                                          ToolTip="删除当前选中的配方文件（不可恢复）" IsEnabled="False"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="📦 产品配方" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RecipeComboBox" Width="200" Height="30" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="FullPath"
                                  SelectionChanged="RecipeComboBox_SelectionChanged"/>
                        <!-- 配方管理操作合并为单个下拉菜单，避免标题栏溢出 -->
                        <Button x:Name="RecipeActionsButton" Content="⋮" FontSize="16" Padding="6,0" Height="30" Width="30"
                                Margin="6,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip="配方管理：新建 / 重命名 / 删除"
                                Click="RecipeActionsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态概览 -->
        <Border Grid.Row="2" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="检测状态" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock" Text="未初始化" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="当前步骤" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StepTextBlock" Text="0/0" FontSize="14" FontWeight="Bold" 
                              Foreground="#1890FF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="耗时" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" FontSize="14" FontWeight="Bold" 
                              Foreground="#FA8C16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="检测结果" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultTextBlock" Text="--" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SOP 检测缩略图 + 开关 -->
        <Border Grid.Row="3" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 开关行：缩略图显示 / 违规自动存图 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="ThumbnailCheckBox" Content="🖼 检测缩略图"
                              Margin="0,0,14,0" VerticalAlignment="Center"
                              Checked="ThumbnailCheckBox_Changed" Unchecked="ThumbnailCheckBox_Changed"/>
                    <CheckBox x:Name="ViolationCaptureCheckBox" Content="💾 违规保存截图"
                              VerticalAlignment="Center"
                              Checked="ViolationCaptureCheckBox_Changed" Unchecked="ViolationCaptureCheckBox_Changed"/>
                </StackPanel>

                <!-- 缩略图显示区 -->
                <Border Grid.Row="1" x:Name="ThumbnailHost" BorderBrush="#CCC" BorderThickness="1"
                        Background="#FAFAFA" Height="160">
                    <Grid>
                        <Image x:Name="ThumbnailImage" Stretch="Uniform" Margin="4"/>
                        <TextBlock x:Name="ThumbnailPlaceholder" Text="检测运行时显示实时缩略图"
                                   Foreground="#BBB" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 检测流程列表 - 垂直列表布局（右侧区域全部让给 SOP 流程；
             运行日志已移至独立窗口 SopLogWindow，此处不再占用高度） -->
        <Border Grid.Row="4" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="StepsPanel" Orientation="Vertical" Margin="5">
                    <!-- 步骤项将通过代码动态添加 -->
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
