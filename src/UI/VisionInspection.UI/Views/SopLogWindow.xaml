<Window x:Class="VisionInspection.UI.Views.SopLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="/Assets/AppIcon.ico"
        Title="运行日志 - SOP" Height="560" Width="760"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📝" FontSize="20" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="运行日志" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="SOP 实时检测 / 步骤切换 / Modbus 触发等运行信息"
                               FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Padding="0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoScrollCheckBox" Content="自动滚动" IsChecked="True"
                                      VerticalAlignment="Center"/>
                            <TextBlock x:Name="LineCountText" Text="0 行" FontSize="11" Foreground="#999"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="📋 复制全部" Padding="12,5" Margin="0,0,6,0" Click="CopyAllButton_Click"
                                    ToolTip="把全部日志复制到剪贴板"/>
                            <Button Content="🗑 清空" Padding="12,5" Click="ClearButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         BorderThickness="0" Background="Transparent" Padding="12,8"
                         FontFamily="Consolas,Microsoft YaHei" FontSize="12"
                         IsUndoEnabled="False"/>
            </Grid>
        </Border>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock Text="窗口可保持常开，不影响主界面操作" Foreground="#999" FontSize="11"
                           VerticalAlignment="Center"/>
                <Button Content="关闭" HorizontalAlignment="Right" Padding="20,6" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
