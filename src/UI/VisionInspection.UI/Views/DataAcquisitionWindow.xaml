<Window x:Class="VisionInspection.UI.Views.DataAcquisitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据采集（录像 → 抽帧 → 预标注）"
        Width="1000" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="NumStyle" TargetType="TextBox">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="RowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="ActBtnStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="数据采集：录像 → 抽帧 → 自动预标注" FontSize="16" FontWeight="SemiBold"/>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <!-- ============ ① 录像 ============ -->
            <TabItem Header="① 录像">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="会话" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="会话名" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSessionName" Width="260"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="默认按时间自动生成"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="输出根目录" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtOutputRoot" Width="260"/>
                                    <Button x:Name="btnBrowseRoot" Content="浏览..." Width="70" Margin="6,0,0,0" Click="BtnBrowseRoot_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="编码参数" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="视频编码" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbCodec" Width="160"/>
                                    <TextBlock Text="预设" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <ComboBox x:Name="cmbPreset" Width="110" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="源像素格式" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbSrcPixFmt" Width="160"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="默认 RGB24（与相机帧一致）；录出来偏蓝/偏红说明通道反了，改 BGR24"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="CRF 画质" Width="90" VerticalAlignment="Center"/>
                                    <Slider x:Name="sldCrf" Width="150" Minimum="0" Maximum="51" Value="18" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="txtCrf" Text="18" Width="28" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="越小越清晰（MJPEG 时按 2-31 质量用）"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="录制帧率" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbRecordFps" Width="120"/>
                                    <TextBlock Text="最长时长(秒)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtMaxDuration" Style="{StaticResource NumStyle}" Text="0"/>
                                    <TextBlock Text="最大体积(MB)" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtMaxSize" Style="{StaticResource NumStyle}" Text="0"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="0 = 不限"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="操作" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <Button x:Name="btnRecordStart" Content="● 开始录制" Style="{StaticResource ActBtnStyle}" Click="BtnRecordStart_Click"/>
                                    <Button x:Name="btnRecordStop" Content="■ 停止录制" Style="{StaticResource ActBtnStyle}" Click="BtnRecordStop_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="txtRecordStatus" Margin="0,8,0,0" Text="未录制" Foreground="#555"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ② 抽帧 ============ -->
            <TabItem Header="② 抽帧参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <GroupBox Header="源视频" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBox x:Name="txtSourceVideo" Width="480"/>
                                    <Button Content="浏览..." Width="70" Margin="6,0,0,0" Click="BtnBrowseVideo_Click"/>
                                    <Button x:Name="btnUseLastVideo" Content="用刚录的" Width="80" Margin="6,0,0,0" Click="BtnUseLastVideo_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintStyle}" Text="也可以直接选一个已有 mp4 做抽帧测试（不依赖相机）"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="采样策略" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="策略" Width="90" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbStrategy" Width="220" SelectionChanged="CmbStrategy_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel x:Name="panTargetCount" Style="{StaticResource RowStyle}">
                                    <TextBlock Text="目标总数" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtTargetCount" Style="{StaticResource NumStyle}" Text="200"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="★推荐：告诉系统要多少张，自动在整段里均匀抽"/>
                                </StackPanel>
                                <StackPanel x:Name="panIntervalFrames" Style="{StaticResource RowStyle}">
                                    <TextBlock Text="帧间隔" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtIntervalFrames" Style="{StaticResource NumStyle}" Text="10"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="每 N 帧取 1 张"/>
                                </StackPanel>
                                <StackPanel x:Name="panIntervalMs" Style="{StaticResource RowStyle}">
                                    <TextBlock Text="时间间隔(ms)" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtIntervalMs" Style="{StaticResource NumStyle}" Text="500"/>
                                </StackPanel>
                                <StackPanel x:Name="panTargetFps" Style="{StaticResource RowStyle}">
                                    <TextBlock Text="目标帧率" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtTargetFps" Style="{StaticResource NumStyle}" Text="2"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="每秒抽 N 张"/>
                                </StackPanel>
                                <StackPanel x:Name="panScene" Style="{StaticResource RowStyle}">
                                    <TextBlock Text="场景阈值" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSceneThreshold" Style="{StaticResource NumStyle}" Text="0.01"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="实测：4K@60fps 视频 0.01→57帧/30s、0.02→5帧；静态航拍 0.02→33帧/66s。默认 0.01，帧太多就往上调"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="时间范围" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtStartSec" Style="{StaticResource NumStyle}" Text="0"/>
                                    <TextBlock Text="~ 秒" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                    <TextBox x:Name="txtEndSec" Style="{StaticResource NumStyle}" Text="0"/>
                                    <TextBlock Style="{StaticResource HintStyle}" Text="结束为 0 表示到片尾"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="质量过滤（剔除糊图/过暗过曝/无纹理）" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="chkQuality" Content="启用质量过滤" IsChecked="True" Margin="0,0,0,6"/>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="最小清晰度" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtMinSharpness" Style="{StaticResource NumStyle}" Text="80"/>
                                    <TextBlock Text="亮度区间" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtMinBrightness" Style="{StaticResource NumStyle}" Text="30"/>
                                    <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                    <TextBox x:Name="txtMaxBrightness" Style="{StaticResource NumStyle}" Text="225"/>
                                    <TextBlock Text="最小对比度" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtMinContrast" Style="{StaticResource NumStyle}" Text="15"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintStyle}" Text="清晰度=拉普拉斯方差，随分辨率/内容剧烈变化：静态清晰帧可达 3000+，手持 4K 缩到 1280 通常只有 30~100。默认 20（只剔真糊帧）；结果列表会显示每张的实测值，据此校准"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="去重（避免几乎一样的图浪费标注工时）" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="chkDedup" Content="启用去重" IsChecked="True" Margin="0,0,0,6"/>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="算法" Width="70" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbDedupMethod" Width="110"/>
                                    <TextBlock Text="汉明阈值" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtHamming" Style="{StaticResource NumStyle}" Text="8"/>
                                    <TextBlock Text="直方图阈值" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtHistTh" Style="{StaticResource NumStyle}" Text="0.985"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="比对范围" Width="70" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbDedupScope" Width="150"/>
                                    <CheckBox x:Name="chkCrossSession" Content="跨会话全局去重" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="输出" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="格式" Width="70" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbFormat" Width="90"/>
                                    <TextBlock Text="JPEG 质量" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtJpegQuality" Style="{StaticResource NumStyle}" Text="95"/>
                                    <CheckBox x:Name="chkGrayscale" Content="灰度输出" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="缩放" Width="70" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cmbResize" Width="140" SelectionChanged="CmbResize_SelectionChanged"/>
                                    <TextBlock x:Name="lblResize1" Text="长边上限" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtResize1" Style="{StaticResource NumStyle}" Text="1920"/>
                                    <TextBlock x:Name="lblResize2" Text="" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtResize2" Style="{StaticResource NumStyle}" Text="0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="命名" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="文件名模板" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtPattern" Width="300" Text="{}{session}_{index:D6}"/>
                                    <TextBlock Text="起始序号" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtStartIndex" Style="{StaticResource NumStyle}" Text="0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintStyle}" Text="可用变量：{session} {index} {index:D6} {timestamp} {time_ms} {frame}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="数量守护" Margin="0,8,0,0" Padding="8">
                            <StackPanel Style="{StaticResource RowStyle}">
                                <TextBlock Text="最多输出张数" Width="90" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMaxOutput" Style="{StaticResource NumStyle}" Text="2000"/>
                                <TextBlock Style="{StaticResource HintStyle}" Text="超出直接截断，防止误操作生成几万张"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="自动预标注" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="chkAutoLabel" Content="启用自动预标注（导出 YOLO .txt）" IsChecked="True" Margin="0,0,0,6"/>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="模型(.onnx)" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtModelPath" Width="380"/>
                                    <Button Content="浏览..." Width="70" Margin="6,0,0,0" Click="BtnBrowseModel_Click"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource RowStyle}">
                                    <TextBlock Text="置信度" Width="90" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtConf" Style="{StaticResource NumStyle}" Text="0.25"/>
                                    <TextBlock Text="IoU" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBox x:Name="txtIou" Style="{StaticResource NumStyle}" Text="0.45"/>
                                    <CheckBox x:Name="chkKeepNegative" Content="保留无目标负样本" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Style="{StaticResource RowStyle}" Margin="0,12,0,0">
                            <Button x:Name="btnEstimate" Content="📊 预估" Style="{StaticResource ActBtnStyle}" Click="BtnEstimate_Click"/>
                            <Button x:Name="btnExtract" Content="▶ 开始抽帧" Style="{StaticResource ActBtnStyle}" Click="BtnExtract_Click"/>
                            <Button x:Name="btnCancel" Content="⏹ 取消" Style="{StaticResource ActBtnStyle}" Click="BtnCancel_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ ③ 结果 ============ -->
            <TabItem Header="③ 结果">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtSummary" Grid.Row="0" Text="尚未执行抽帧" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <ListView x:Name="listResults" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding FileName}" Width="240"/>
                                <GridViewColumn Header="源时间(s)" DisplayMemberBinding="{Binding SourceTimeSec}" Width="90"/>
                                <GridViewColumn Header="清晰度" DisplayMemberBinding="{Binding Sharpness}" Width="90"/>
                                <GridViewColumn Header="亮度" DisplayMemberBinding="{Binding Brightness}" Width="80"/>
                                <GridViewColumn Header="对比度" DisplayMemberBinding="{Binding Contrast}" Width="80"/>
                                <GridViewColumn Header="目标数" DisplayMemberBinding="{Binding Instances}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btnOpenFolder" Content="📂 打开输出目录" Width="150" Height="32" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="txtStatus" Text="就绪"/>
            <ProgressBar x:Name="pbProgress" Width="300" Height="14" Margin="16,0,0,0" Minimum="0" Maximum="100"/>
        </StatusBar>
    </Grid>
</Window>
